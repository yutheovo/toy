# The `-W` option is not POSIX-compliant, so we need to handle it differently.
# The `-X` option is not POSIX-compliant, so we need to handle it differently.
# The `-Y` option is not POSIX-compliant, so we need to handle it differently.
# The `-Z` option is not POSIX-compliant, so we need to handle it differently.
exec "$JAVACMD" "$@"
